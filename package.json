{
  "name": "bolt-tap",
  "version": "0.1.0",
  "author": "Hades",
  "license": "MIT",
  "homepage": "https://elysiumno.de/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "sync": "ng build && npx cap sync",
    "deploy": "ng build && npx cap sync android && cd android && call gradlew.bat installDebug && cd .. && adb shell am start -n io.ionic.starter/.MainActivity",
    "assemble:debug": "ng build && npx cap sync android && cd android && call gradlew.bat assembleDebug",
    "assemble:release": "ng build && npx cap sync android && cd android && call gradlew.bat assembleRelease",
    "bundle:release": "ng build && npx cap sync android && cd android && call gradlew.bat bundleRelease"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.27",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/platform-browser": "20.3.27",
    "@angular/platform-browser-dynamic": "20.3.27",
    "@angular/router": "20.3.27",
    "@capacitor-community/bluetooth-le": "^7.3.0",
    "@capacitor/android": "7.4.4",
    "@capacitor/app": "^7.1.2",
    "@capacitor/barcode-scanner": "2.2.0",
    "@capacitor/clipboard": "7.0.2",
    "@capacitor/core": "7.4.4",
    "@exxili/capacitor-nfc": "0.0.12",
    "@ionic/angular": "^8.7.17",
    "@mmote/niimbluelib": "0.0.1-alpha.29",
    "bech32": "2.0.0",
    "ionicons": "7.4.0",
    "light-bolt11-decoder": "3.2.0",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.27",
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/cli": "^20.3.27",
    "@angular/compiler-cli": "20.3.27",
    "@angular/language-service": "20.3.27",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "7.4.4",
    "@ionic/angular-toolkit": "12.3.0",
    "@types/jasmine": "5.1.13",
